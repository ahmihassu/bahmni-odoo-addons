<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<!-- Cashiers only see documents for shops assigned on their user. -->
		<record id="group_cashier_own_shop" model="res.groups">
			<field name="name">Cashier: Own Shop Orders Only</field>
			<field name="category_id" ref="base.module_category_sales_management"/>
			<field name="comment">Restrict sale orders and customer invoices to the shop(s) set on the user.</field>
			<field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
		</record>

		<record id="rule_sale_order_cashier_own_shop" model="ir.rule">
			<field name="name">Cashier: sale orders of assigned shops</field>
			<field name="model_id" ref="sale.model_sale_order"/>
			<field name="groups" eval="[(4, ref('group_cashier_own_shop'))]"/>
			<field name="domain_force">[('shop_id', 'in', user.shop_ids.ids)]</field>
			<field name="perm_read" eval="True"/>
			<field name="perm_write" eval="True"/>
			<field name="perm_create" eval="True"/>
			<field name="perm_unlink" eval="True"/>
		</record>

		<record id="rule_sale_order_line_cashier_own_shop" model="ir.rule">
			<field name="name">Cashier: sale order lines of assigned shops</field>
			<field name="model_id" ref="sale.model_sale_order_line"/>
			<field name="groups" eval="[(4, ref('group_cashier_own_shop'))]"/>
			<field name="domain_force">[('order_id.shop_id', 'in', user.shop_ids.ids)]</field>
			<field name="perm_read" eval="True"/>
			<field name="perm_write" eval="True"/>
			<field name="perm_create" eval="True"/>
			<field name="perm_unlink" eval="True"/>
		</record>

		<record id="rule_account_invoice_cashier_own_shop" model="ir.rule">
			<field name="name">Cashier: invoices of assigned shops</field>
			<field name="model_id" ref="account.model_account_invoice"/>
			<field name="groups" eval="[(4, ref('group_cashier_own_shop'))]"/>
			<field name="domain_force">[('shop_id', 'in', user.shop_ids.ids)]</field>
			<field name="perm_read" eval="True"/>
			<field name="perm_write" eval="True"/>
			<field name="perm_create" eval="True"/>
			<field name="perm_unlink" eval="True"/>
		</record>
	</data>
</odoo>
