<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bahmni_paid_payments_export_form" model="ir.ui.view">
        <field name="name">bahmni.paid.payments.export.form</field>
        <field name="model">bahmni.paid.payments.export</field>
        <field name="arch" type="xml">
            <form string="Paid Payments Export">
                <field name="state" invisible="1"/>
                <group states="choose">
                    <group string="Period">
                        <field name="period_type"/>
                        <field name="eth_month"
                                 attrs="{'invisible': [('period_type', '!=', 'ethiopian')],
                                         'required': [('period_type', '=', 'ethiopian')]}"/>
                        <field name="eth_year"
                                 attrs="{'invisible': [('period_type', '!=', 'ethiopian')],
                                         'required': [('period_type', '=', 'ethiopian')]}"/>
                        <field name="date_from"
                                 attrs="{'invisible': [('period_type', '!=', 'range')],
                                         'required': [('period_type', '=', 'range')]}"/>
                        <field name="date_to"
                                 attrs="{'invisible': [('period_type', '!=', 'range')],
                                         'required': [('period_type', '=', 'range')]}"/>
                        <field name="date_basis"/>
                    </group>
                    <group string="Filters">
                        <field name="company_id"/>
                        <field name="payment_method"/>
                        <field name="credit_information"
                                 attrs="{'invisible': [('payment_method', 'not in', ['all', 'Credit'])]}"/>
                        <field name="shop_id"/>
                        <field name="journal_id"/>
                    </group>
                </group>
                <div states="get">
                    <h2>Paid payments Excel ready</h2>
                    <p>
                        <field name="row_count" readonly="1" class="oe_inline"/>
                        row(s), total amount
                        <field name="total_amount" readonly="1" class="oe_inline"/>
                    </p>
                    <field name="data_fname" invisible="1"/>
                    <field name="data" readonly="1" filename="data_fname"/>
                </div>
                <footer states="choose">
                    <button name="action_generate_excel"
                            string="Generate Excel"
                            type="object"
                            class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
                <footer states="get">
                    <button string="Close" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bahmni_paid_payments_export" model="ir.actions.act_window">
        <field name="name">Paid Payments Export</field>
        <field name="res_model">bahmni.paid.payments.export</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bahmni_paid_payments_export"
              name="Paid Payments Export"
              parent="account.menu_finance_reports"
              action="action_bahmni_paid_payments_export"
              sequence="56"/>
    <menuitem id="menu_bahmni_paid_payments_export_sales"
              name="Paid Payments Export"
              parent="sales_team.menu_sale_report"
              action="action_bahmni_paid_payments_export"
              sequence="56"/>
</odoo>
