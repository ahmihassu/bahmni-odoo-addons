<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Runs on install and every upgrade. -->
        <function model="res.company" name="bahmni_disable_taxes"/>
    </data>

    <record id="view_account_form_no_tax" model="ir.ui.view">
        <field name="name">account.account.form.no.tax</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="tax_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="product_template_form_no_tax" model="ir.ui.view">
        <field name="name">product.template.form.no.tax</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="supplier_taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
