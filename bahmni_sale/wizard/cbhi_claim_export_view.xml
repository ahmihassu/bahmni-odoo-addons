<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bahmni_cbhi_claim_export_form" model="ir.ui.view">
        <field name="name">bahmni.cbhi.claim.export.form</field>
        <field name="model">bahmni.cbhi.claim.export</field>
        <field name="arch" type="xml">
            <form string="Payer Claim Export">
                <field name="state" invisible="1"/>
                <group states="choose">
                    <group>
                        <field name="claim_type"/>
                        <field name="eth_month"/>
                        <field name="eth_year"/>
                    </group>
                    <group>
                        <field name="company_id"/>
                    </group>
                </group>
                <div states="get">
                    <h2>Claim Excel ready</h2>
                    <p>
                        <field name="invoice_count" readonly="1" class="oe_inline"/>
                        open invoice(s) included.
                    </p>
                    <field name="data_fname" invisible="1"/>
                    <field name="data" readonly="1" filename="data_fname"/>
                </div>
                <footer states="choose">
                    <button name="action_generate_excel"
                            string="Generate Excel"
                            type="object"
                            class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
                <footer states="get">
                    <button string="Close" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bahmni_cbhi_claim_export" model="ir.actions.act_window">
        <field name="name">Payer Claim Export</field>
        <field name="res_model">bahmni.cbhi.claim.export</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bahmni_cbhi_claim_export"
              name="Payer Claim Export"
              parent="account.menu_finance_reports"
              action="action_bahmni_cbhi_claim_export"
              sequence="55"/>
    <menuitem id="menu_bahmni_cbhi_claim_export_sales"
              name="Payer Claim Export"
              parent="sales_team.menu_sale_report"
              action="action_bahmni_cbhi_claim_export"
              sequence="55"/>
</odoo>
