<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="inherit_view_invoice_form_shop" model="ir.ui.view">
		<field name="name">inherit.account.invoice.form.shop</field>
		<field name="model">account.invoice</field>
		<field name="inherit_id" ref="account.invoice_form"/>
		<field name="priority" eval="99"/>
		<field name="arch" type="xml">
			<xpath expr="//header" position="inside">
				<!-- Register Payment / outstanding credits are hidden for Credit bills in fields_view_get. -->
				<field name="bahmni_is_credit" invisible="1"/>
			</xpath>
			<xpath expr="//field[@name='date_invoice']" position="after">
				<field name="shop_id"
					options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
				<field name="payment_method"/>
				<field name="patient_partner_id"
					attrs="{'invisible': [('patient_partner_id', '=', False)]}"/>
				<field name="payer_partner_id"
					attrs="{'invisible': [('payment_method', '!=', 'Credit')]}"/>
				<field name="credit_information"
					attrs="{'invisible': [('payment_method', '!=', 'Credit')]}"/>
				<field name="free_reason"
					attrs="{'invisible': [('payment_method', '!=', 'Free')]}"/>
			</xpath>
		</field>
	</record>

	<!-- Disabled leftover from v1.22 (kept so xml id stays valid). -->
	<record id="inherit_view_invoice_form_hide_credit_register_payment" model="ir.ui.view">
		<field name="name">account.invoice.form.hide.credit.register.payment (disabled)</field>
		<field name="model">account.invoice</field>
		<field name="inherit_id" ref="account.invoice_form"/>
		<field name="active" eval="False"/>
		<field name="priority" eval="200"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="attributes">
				<attribute name="string">Customer Invoice</attribute>
			</xpath>
		</field>
	</record>
</odoo>
